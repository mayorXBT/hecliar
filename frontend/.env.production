# Public configuration for the deployed build. Every value here is
# NEXT_PUBLIC_ and therefore ships to the browser by design: a contract
# address and a chain id are public facts, not secrets.
#
# Transport follows the mode, not this setting: robot play is always in-memory
# and friend play is always on-chain, because neither works on the other's
# transport. This only decides where a match of unknown mode goes.

NEXT_PUBLIC_GAME_TRANSPORT=chain
NEXT_PUBLIC_HECLIAR_ADDRESS=0xF003E11d9309C55788D3daBA7393453A53AD900B
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_ROBOT_ADDRESS=0x000000000000000000000000000000000000dEaD
